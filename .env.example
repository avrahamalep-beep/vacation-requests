# Neon: Dashboard → Connection details → copy "Connection string" (pooling recommended for server apps).
DATABASE_URL=postgresql://USER:PASSWORD@EP-xxx.region.aws.neon.tech/neondb?sslmode=require

# Set by the host in production. Often 80/443 is mapped here.
PORT=3847

# If the React app and API are on different domains, set the API base (no trailing slash).
# Leave empty when using npm run start (same host shows web + /api).
#VITE_API_BASE_URL=https://api.example.com

# Public HTTPS URL to share (Render, etc.). Shown in the app and used by: npm run share
#VITE_PUBLIC_APP_URL=https://your-app.onrender.com
